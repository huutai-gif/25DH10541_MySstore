
@model _25DH10541_MySstore.Models.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AminLayout.cshtml";
}

<h2 class="bg-success">XÓA SẢN PHẨM</h2>

<h4 class="bg-danger">Bạn thực sự muốn xóa sản phẩm này à?</h4>

@Html.Partial("PVProductInfo", Model)

<div class="container-fluid">
    <div class="row">
        <div class="col-md-7"
             style="display: flex; justify-content: flex-end; gap: 6px;">

            @Html.ActionLink("Xóa", "Delete",
                new { id = Model.ProductID },
                new { @class = "btn btn-primary" })

            @Html.ActionLink("Quay lại danh sách", "Index", null,
                new { @class = "btn btn-primary" })

        </div>
    </div>
</div>
